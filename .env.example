# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key_here

# Analytics (PostHog) — Project API key from PostHog → Project settings.
# Without a key, analytics stays off (handy for local dev).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
# Region: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Where links to the PostHog app point: https://us.posthog.com or https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Next.js
NEXT_PUBLIC_SITE_URL=https://keisoftware.dev

# Bundle Analysis (opcional)
# ANALYZE=true
